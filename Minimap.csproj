<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>OverTheHill.Minimap</AssemblyName>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\over the hill</GameDir>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="diagnostics/**/*.cs" />
    <Reference Exclude="C:\Program Files\dotnet\shared\Microsoft.NETCore.App\6.0.36\System.IO.Compression.Native.dll" Include="C:\Program Files\dotnet\shared\Microsoft.NETCore.App\6.0.36\System.*.dll;C:\Program Files\dotnet\shared\Microsoft.NETCore.App\6.0.36\mscorlib.dll;C:\Program Files\dotnet\shared\Microsoft.NETCore.App\6.0.36\netstandard.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>


